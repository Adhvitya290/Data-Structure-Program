include <iostream>
#include <string>
using namespace std;

struct Product {
int id;
string name;
string category;
float price;
int quantity;};

Product products[10];
int count = 0;

// Add Product
void addProduct(){
if (count == 10) {
cout << "Catalog is full!";
return;}

cout << "Enter Product ID: ";
cin >> products[count].id;

cout << "Enter Product Name: ";
cin.ignore();
getline(cin, products[count].name);

cout << "Enter Category: ";
getline(cin, products[count].category);

cout << "Enter Price: ";
cin >> products[count].price;

cout << "Enter Quantity: ";
cin >> products[count].quantity;
count++;

cout << "Product added successfully!\n";}

// Search Product
void searchProduct(){
int id;
cout << "Enter Product ID: ";
cin >> id;

for (int i = 0; i < count; i++) {
if (products[i].id == id) {
cout << "\nProduct Found!";
cout << "\nName: " << products[i].name;
cout << "\nCategory: " << products[i].category;
cout << "\nPrice: " << products[i].price;
cout << "\nQuantity: " << products[i].quantity;
return;}
}

cout << "Product not found!\n";}

